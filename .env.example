# --- Postgres ---
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega_pass
POSTGRES_DB=omega_crm
POSTGRES_PORT=5433

# --- Ports ---
API_PORT=8010
WEB_PORT=5180

# --- Security ---
# openssl rand -hex 32
SECRET_KEY=CHANGE_ME_super_secret_key_min_32_chars_long_please
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- First super admin (faqat birinchi ishga tushirishda yaratiladi) ---
FIRST_SUPERADMIN_USERNAME=admin
FIRST_SUPERADMIN_PASSWORD=admin123
FIRST_SUPERADMIN_NAME=Super Admin

# --- App ---
DEFAULT_LANG=ru
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# --- Frontend ---
VITE_API_URL=http://localhost:8010
